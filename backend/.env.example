# ===== Backend env (sao chép thành .env rồi điền giá trị thật) =====

# Postgres (Neon) — kèm ?sslmode=require
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Khóa bí mật (mỗi cái 1 chuỗi random khác nhau, vd: openssl rand -hex 32)
SESSION_SECRET=
AUDIT_LOG_KEY=
TOTP_ENC_KEY=

# bcrypt hash của "câu mở kho thật" (node -e "console.log(require('bcryptjs').hashSync('...',12))")
VAULT_REAL_CODE_HASH=
# Câu mở kho mồi (plaintext)
FAKE_CODE=

# Môi trường + CORS
NODE_ENV=production
CLIENT_ORIGIN=https://demo234.id.vn

# Tự khóa kho sau (giây)
AUTO_LOCK_SECONDS=300

# Proxy / IP thật (sau Vercel->Cloudflare->Render)
TRUST_PROXY=1
CLIENT_IP_HEADER=x-vercel-forwarded-for

# (tùy chọn) API key kiểm tra danh tiếng URL
SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=
